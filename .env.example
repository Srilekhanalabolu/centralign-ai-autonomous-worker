# --- LLM (optional). Leave LLM_API_KEY empty to run in Demo mode. ---
# Any OpenAI-compatible Chat Completions endpoint works (OpenAI, Groq, Together, OpenRouter, local vLLM/Ollama...)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Force deterministic demo decisions even if a key is set
DEMO_MODE=false

# --- Runtime ---
PORT=8000
APPROVAL_THRESHOLD=50000
# Pause between agent steps so the live timeline is easy to follow on screen
STEP_DELAY_SECONDS=0.7
MAX_AGENT_STEPS=16
MAX_TOOL_RETRIES=3
# FINANCE_API_URL defaults to http://127.0.0.1:$PORT
# FINANCE_DB_PATH defaults to app/sandbox/finance.db
